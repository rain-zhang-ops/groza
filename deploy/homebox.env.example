# Groza (Homebox 定制) 环境变量示例
# 复制为 ~/.config/homebox/homebox.env 并填入真实值；权限建议 chmod 600。
# 说明：HBOX_AUTH_API_KEY_PEPPER 变更会导致已签发的会话失效，请谨慎。

# 基础
TZ=Asia/Shanghai
HBOX_OPTIONS_ALLOW_ANALYTICS=false
HBOX_LOG_LEVEL=info
HBOX_LOG_FORMAT=text
HBOX_WEB_MAX_UPLOAD_SIZE=10
# 大文件/慢网络：放宽 Web 超时（AI 识别、批量入库等）
HBOX_WEB_WRITE_TIMEOUT=180s
HBOX_WEB_READ_TIMEOUT=60s

# 数据库（本项目固定使用 SQLite）
HBOX_DATABASE_DRIVER=sqlite
HBOX_DATABASE_SQLITE_PATH=/data/homebox.db

# 安全：替换为随机长串
HBOX_AUTH_API_KEY_PEPPER=change-me-to-a-long-random-string

# AI 识别（豆包 / 火山方舟）；联网搜索需在方舟控制台开通插件
HBOX_AI_ARK_KEY=
HBOX_AI_ARK_MODEL=doubao-seed-2-1-pro-260628
